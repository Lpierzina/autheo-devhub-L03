# {{ ansible_managed }}
# policy-id: {{ build_executor_policy_id }}
# This table only claims packets crossing the dedicated BuildExecutor bridge;
# every other host packet continues to the fleet's existing firewall unchanged.
table inet {{ build_executor_nft_table }} {
    comment "{{ build_executor_policy_id }}"

    set denied_ipv4 {
        type ipv4_addr
        flags interval
        elements = {
            0.0.0.0/8,
            10.0.0.0/8,
            100.64.0.0/10,
            127.0.0.0/8,
            168.63.129.16/32,
            169.254.0.0/16,
            172.16.0.0/12,
            192.0.0.0/24,
            192.0.2.0/24,
            192.31.196.0/24,
            192.52.193.0/24,
            192.88.99.0/24,
            192.168.0.0/16,
            192.175.48.0/24,
            198.18.0.0/15,
            198.51.100.0/24,
            203.0.113.0/24,
            224.0.0.0/4,
            240.0.0.0/4
        }
    }

    set fleet_ipv4 {
        type ipv4_addr
        elements = { {{ build_executor_fleet_public_ipv4_sorted | join(', ') }} }
    }

    counter dns_allowed {}
    counter web_allowed {}
    counter host_denied {}
    counter dnat_denied {}
    counter denied_destination {}
    counter fleet_denied {}
    counter ipv6_denied {}
    counter egress_default_denied {}
    counter ingress_to_executor_denied {}

    chain executor_to_host {
        type filter hook input priority 10; policy accept;

        iifname "{{ build_executor_network_bridge }}" meta nfproto ipv6 counter name ipv6_denied drop comment "be-input-ipv6"
        iifname "{{ build_executor_network_bridge }}" ip daddr {{ build_executor_network_gateway }} meta l4proto udp ct original proto-dst 53 counter name dns_allowed accept comment "be-input-dns-udp"
        iifname "{{ build_executor_network_bridge }}" ip daddr {{ build_executor_network_gateway }} meta l4proto tcp ct original proto-dst 53 counter name dns_allowed accept comment "be-input-dns-tcp"
        iifname "{{ build_executor_network_bridge }}" counter name host_denied drop comment "be-input-default"
    }

    chain executor_forward {
        type filter hook forward priority 10; policy accept;

        iifname "{{ build_executor_network_bridge }}" meta nfproto ipv6 counter name ipv6_denied drop comment "be-forward-egress-ipv6"
        oifname "{{ build_executor_network_bridge }}" meta nfproto ipv6 counter name ipv6_denied drop comment "be-forward-ingress-ipv6"

        iifname "{{ build_executor_network_bridge }}" ct state invalid counter name egress_default_denied drop comment "be-forward-invalid"
        iifname "{{ build_executor_network_bridge }}" ct status dnat counter name dnat_denied drop comment "be-forward-dnat"
        iifname "{{ build_executor_network_bridge }}" ip daddr @denied_ipv4 counter name denied_destination drop comment "be-forward-special"
        iifname "{{ build_executor_network_bridge }}" ip daddr @fleet_ipv4 counter name fleet_denied drop comment "be-forward-fleet"
        iifname "{{ build_executor_network_bridge }}" tcp dport { 80, 443 } ct state { new, established } counter name web_allowed accept comment "be-forward-web"
        iifname "{{ build_executor_network_bridge }}" counter name egress_default_denied drop comment "be-forward-egress-default"

        oifname "{{ build_executor_network_bridge }}" ct state established accept comment "be-forward-ingress-established"
        oifname "{{ build_executor_network_bridge }}" counter name ingress_to_executor_denied drop comment "be-forward-ingress-default"
    }
}

table bridge {{ build_executor_nft_bridge_table }} {
    comment "{{ build_executor_policy_id }}"

    counter lateral_denied {}

    chain executor_lateral {
        type filter hook forward priority 10; policy accept;
        ibrname "{{ build_executor_network_bridge }}" obrname "{{ build_executor_network_bridge }}" counter name lateral_denied drop comment "be-bridge-lateral"
    }
}
{% if build_executor_migration_enabled | bool %}

# Marketplace migrations have no DNS and no ambient egress. This is separate
# from the ordinary executor table so a migration target can never broaden it.
table inet {{ build_executor_migration_nft_table }} {
    comment "{{ build_executor_migration_policy_id }}"
    counter target_allowed {}
    counter return_allowed {}
    counter migration_denied {}
    counter migration_dnat_denied {}
    counter migration_ipv6_denied {}
    chain migration_input {
        type filter hook input priority 9; policy accept;
        iifname "{{ build_executor_migration_network_bridge }}" counter name migration_denied drop comment "migration-input-drop"
    }
    chain migration_forward {
        type filter hook forward priority 9; policy accept;
        iifname "{{ build_executor_migration_network_bridge }}" meta nfproto ipv6 counter name migration_ipv6_denied drop comment "migration-ipv6-drop"
        oifname "{{ build_executor_migration_network_bridge }}" meta nfproto ipv6 counter name migration_ipv6_denied drop comment "migration-return-ipv6-drop"
        iifname "{{ build_executor_migration_network_bridge }}" ct status dnat counter name migration_dnat_denied drop comment "migration-dnat-drop"
        iifname "{{ build_executor_migration_network_bridge }}" ip daddr {{ build_executor_migration_target_ipv4 }} tcp dport 5432 ct state new counter name target_allowed accept comment "migration-target-5432"
        iifname "{{ build_executor_migration_network_bridge }}" counter name migration_denied drop comment "migration-egress-drop"
        oifname "{{ build_executor_migration_network_bridge }}" ip saddr {{ build_executor_migration_target_ipv4 }} tcp sport 5432 ct state established,related counter name return_allowed accept comment "migration-return"
        oifname "{{ build_executor_migration_network_bridge }}" counter name migration_denied drop comment "migration-ingress-drop"
    }
}
table bridge {{ build_executor_migration_nft_bridge_table }} {
    comment "{{ build_executor_migration_policy_id }}"
    counter migration_lateral_denied {}
    chain migration_lateral {
        type filter hook forward priority 9; policy accept;
        ibrname "{{ build_executor_migration_network_bridge }}" counter name migration_lateral_denied drop comment "migration-lateral-drop"
        obrname "{{ build_executor_migration_network_bridge }}" counter name migration_lateral_denied drop comment "migration-lateral-return-drop"
    }
}
{% endif %}
