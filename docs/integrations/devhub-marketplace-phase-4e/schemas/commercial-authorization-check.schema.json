{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketplace-devhub.invalid/schemas/commercial-authorization-check-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["authorization_id", "workload_order_id", "buyer_tenant_id", "workload_class", "policy", "expected_authorization_revision"],
  "properties": {
    "authorization_id": { "$ref": "#/$defs/identifier" },
    "workload_order_id": { "$ref": "#/$defs/identifier" },
    "buyer_tenant_id": { "$ref": "#/$defs/identifier" },
    "workload_class": { "$ref": "#/$defs/identifier" },
    "policy": { "$ref": "#/$defs/policy" },
    "expected_authorization_revision": { "$ref": "#/$defs/revision" }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 256 },
    "revision": { "type": "integer", "minimum": 1 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version"],
      "properties": {
        "policy_id": { "type": "string", "minLength": 1 },
        "policy_version": { "$ref": "#/$defs/revision" }
      }
    },
    "response": { "type": "object", "additionalProperties": false, "required": ["result"], "properties": { "result": { "enum": ["active", "expired", "revoked", "stale", "binding_mismatch", "policy_mismatch", "unavailable"] } } }
  }
}
